<Window x:Class="ePrescriptions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ePrescriptions.App.ViewModels"
        xmlns:views="clr-namespace:ePrescriptions.App.Views"
        xmlns:svc="clr-namespace:ePrescriptions.App.Services"
        mc:Ignorable="d"
        Title="E-Prescriptions - النظام المتكامل لإدارة الصيدليات والوصفات الطبية"
        Icon="pack://application:,,,/Resources/app.ico"
        Height="800" Width="1366"
        MinHeight="560" MinWidth="900"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundGradient}">

    <!-- تعيين DataTemplates لربط كل ViewModel بـ View الخاصة به -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <svc:ViewTypeMatchConverter x:Key="ViewMatch" />

        <!-- ===== القائمة العلوية بالتصنيفات =====
             ملاحظة: ستايل TextBlock الافتراضي بيفرض لون غامق، فبنربط لون أي TextBlock جوه الزر بلون الزر نفسه -->
        <Style x:Key="MenuCategoryButton" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
            </Style.Resources>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0B3556" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="18,9">
                            <Grid>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <Border x:Name="Underline" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-9" Background="#0083CB" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#0155A5" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF5FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemButton" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
            </Style.Resources>
            <EventSetter Event="Click" Handler="MenuItem_Click" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#0B3556" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="16,9">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CFE8F7" />
                                <Setter Property="Foreground" Value="#0155A5" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF5FB" />
                                <Setter Property="Foreground" Value="#0155A5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuPopupBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#B9D6E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Padding" Value="0,4" />
        </Style>

        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupplierReturnsViewModel}">
            <views:SupplierReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseOrdersViewModel}">
            <views:PurchaseOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StocktakeViewModel}">
            <views:StocktakeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpeningStockViewModel}">
            <views:OpeningStockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PriceListImportViewModel}">
            <views:PriceListImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <views:StaffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZakatViewModel}">
            <views:ZakatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OwnerLogViewModel}">
            <views:OwnerLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffAuditLogViewModel}">
            <views:StaffAuditLogView />
        </DataTemplate>
    </Window.Resources>

    <!-- اختصارات لوحة المفاتيح العامة (F1..F10, Delete) -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CurrentView.NewInvoiceCommand}" />
        <KeyBinding Key="F2" Command="{Binding CurrentView.SaveInvoiceCommand}" />
        <KeyBinding Key="F3" Command="{Binding CurrentView.PrintInvoiceCommand}" />
        <KeyBinding Key="F4" Command="{Binding CurrentView.OpenItemSearchCommand}" />
        <KeyBinding Key="Delete" Command="{Binding CurrentView.RemoveSelectedItemCommand}" />
        <KeyBinding Key="F8" Command="{Binding CurrentView.SuspendInvoiceCommand}" />
        <KeyBinding Key="F9" Command="{Binding CurrentView.ToggleReturnModeCommand}" />
        <KeyBinding Key="F10" Command="{Binding CurrentView.OpenCashDrawerCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- الشريط العلوي الرئيسي مع الساعة الحية وحالة المستخدم -->
            <RowDefinition Height="46" />
            <!-- شريط تنبيه النسخ الاحتياطي (يظهر عند وجود مشكلة فقط) -->
            <RowDefinition Height="Auto" />
            <!-- المحتوى (القائمة العلوية + الشاشة الحالية) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1) الشريط العلوي العام للتطبيق -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource BrandStripeGradient}" BorderThickness="0,0,0,2.5" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- اسم وشعار الصيدلية والنظام -->
                    <ColumnDefinition Width="Auto" />
                    <!-- شريط التاريخ الهجري والميلادي والوقت المباشر (يتحدث كل ثانية) -->
                    <ColumnDefinition Width="*" />
                    <!-- بيانات المستخدم والوردية وقفل الشاشة -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="7" Width="30" Height="30" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconCapsule}" Fill="#0083CB" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="E-Prescriptions" Foreground="White" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="نظام إدارة الصيدليات والوصفات الطبية" Foreground="#DCF1FB" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <!-- شريط الوقت المباشر مع تقويم أم القرى -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#26FFFFFF" CornerRadius="6" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LiveDateTimeString}" Foreground="White" FontWeight="SemiBold" FontSize="11.5" />
                    </StackPanel>
                </Border>

                <!-- المستخدم والوردية الحالية -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ShiftStatusDisplay}" Foreground="#32992B" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Background="#D3277B" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </Border>

                    <!-- زر قفل الشاشة السريع وزر تسجيل الخروج -->
                    <Button Command="{Binding LockScreenCommand}" Background="#26FFFFFF" BorderThickness="0" Cursor="Hand" Padding="10,6" Margin="0,0,6,0">
                        <TextBlock Text="قفل الشاشة" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                    <Button Command="{Binding LogoutCommand}" Background="#FFE4EE" BorderThickness="0" Cursor="Hand" Padding="10,6">
                        <TextBlock Text="خروج" Foreground="#A2165F" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1.5) خطوة 41: تنبيه النسخ الاحتياطي للمدير/المالك -->
        <Border Grid.Row="1" Background="#7F1D1D" Padding="16,6" Visibility="{Binding HasBackupAlert, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding BackupAlertText}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding OpenBackupSettingsCommand}" Content="فتح إعدادات النسخ" Margin="12,0,0,0" Padding="12,2" />
            </Grid>
        </Border>

        <!-- 2) المحتوى الرئيسي: القائمة العلوية بالتصنيفات + شاشة العرض -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <!-- القائمة العلوية بالتصنيفات -->
                <RowDefinition Height="Auto" />
                <!-- الشاشة المعروضة حالياً -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#D5E4EE" BorderThickness="0,0,0,1" Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- التصنيفات من اليمين لليسار (RTL) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,0">
                        <Button x:Name="CatTrade" Style="{StaticResource MenuCategoryButton}" Content="البيع والشراء ▾"
                                Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=SalesViewModel|PurchasesViewModel|PurchaseOrdersViewModel|SupplierReturnsViewModel}"
                                MouseEnter="Category_MouseEnter" MouseLeave="Category_MouseLeave" Click="Category_Click" />
                        <Button x:Name="CatStock" Style="{StaticResource MenuCategoryButton}" Content="المخزون ▾"
                                Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=InventoryViewModel|StocktakeViewModel|OpeningStockViewModel|PriceListImportViewModel}"
                                Visibility="{Binding CanSeeStockMenu, Converter={StaticResource BoolToVis}}"
                                MouseEnter="Category_MouseEnter" MouseLeave="Category_MouseLeave" Click="Category_Click" />
                        <Button x:Name="CatAccounts" Style="{StaticResource MenuCategoryButton}" Content="الحسابات ▾"
                                Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=CustomersViewModel|FinanceViewModel|ZakatViewModel}"
                                Visibility="{Binding CanSeeAccountsMenu, Converter={StaticResource BoolToVis}}"
                                MouseEnter="Category_MouseEnter" MouseLeave="Category_MouseLeave" Click="Category_Click" />
                        <Button x:Name="CatAdmin" Style="{StaticResource MenuCategoryButton}" Content="الإدارة ▾"
                                Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=StaffViewModel|StaffAuditLogViewModel|OwnerLogViewModel|ReportsViewModel|SettingsViewModel|HelpViewModel}"
                                MouseEnter="Category_MouseEnter" MouseLeave="Category_MouseLeave" Click="Category_Click" />
                        <Popup x:Name="PopTrade" PlacementTarget="{Binding ElementName=CatTrade}" Placement="Bottom"
                               StaysOpen="True" AllowsTransparency="False" PopupAnimation="None" FlowDirection="RightToLeft">
                            <Border Style="{StaticResource MenuPopupBorder}" MouseEnter="PopupContent_MouseEnter" MouseLeave="PopupContent_MouseLeave">
                                <StackPanel>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateSalesCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=SalesViewModel}">
                                    <TextBlock Text="المبيعات (F1)" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigatePurchasesCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=PurchasesViewModel}"
                                    Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="المشتريات والموردون" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigatePurchaseOrdersCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=PurchaseOrdersViewModel}"
                                    Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="أوامر الشراء" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateSupplierReturnsCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=SupplierReturnsViewModel}"
                                    Visibility="{Binding CanAccessPurchases, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="مرتجع / إتلاف المنتهي" />
                                </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup x:Name="PopStock" PlacementTarget="{Binding ElementName=CatStock}" Placement="Bottom"
                               StaysOpen="True" AllowsTransparency="False" PopupAnimation="None" FlowDirection="RightToLeft">
                            <Border Style="{StaticResource MenuPopupBorder}" MouseEnter="PopupContent_MouseEnter" MouseLeave="PopupContent_MouseLeave">
                                <StackPanel>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateInventoryCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=InventoryViewModel}"
                                    Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="المخزون والأدوية" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateStocktakeCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=StocktakeViewModel}"
                                    Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="الجرد بالباركود" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateOpeningStockCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=OpeningStockViewModel}"
                                    Visibility="{Binding CanAccessOpeningStock, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="رصيد أول المدة" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigatePriceListImportCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=PriceListImportViewModel}"
                                    Visibility="{Binding CanAccessPriceListImport, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="تحديث الأسعار (Excel)" />
                                </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup x:Name="PopAccounts" PlacementTarget="{Binding ElementName=CatAccounts}" Placement="Bottom"
                               StaysOpen="True" AllowsTransparency="False" PopupAnimation="None" FlowDirection="RightToLeft">
                            <Border Style="{StaticResource MenuPopupBorder}" MouseEnter="PopupContent_MouseEnter" MouseLeave="PopupContent_MouseLeave">
                                <StackPanel>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateCustomersCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=CustomersViewModel}"
                                    Visibility="{Binding CanAccessCustomers, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="حسابات العملاء" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateFinanceCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=FinanceViewModel}"
                                    Visibility="{Binding CanAccessFinance, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="الحسابات والمالية" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateZakatCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=ZakatViewModel}"
                                    Visibility="{Binding CanAccessZakat, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="حاسبة الزكاة" />
                                </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup x:Name="PopAdmin" PlacementTarget="{Binding ElementName=CatAdmin}" Placement="Bottom"
                               StaysOpen="True" AllowsTransparency="False" PopupAnimation="None" FlowDirection="RightToLeft">
                            <Border Style="{StaticResource MenuPopupBorder}" MouseEnter="PopupContent_MouseEnter" MouseLeave="PopupContent_MouseLeave">
                                <StackPanel>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateStaffCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=StaffViewModel}"
                                    Visibility="{Binding CanAccessStaff, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="الموظفون والصلاحيات" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateStaffAuditLogCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=StaffAuditLogViewModel}"
                                    Visibility="{Binding IsAdminOrOwner, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="سجل نشاط الموظفين" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateOwnerLogCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=OwnerLogViewModel}"
                                    Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="سجل نشاطي" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateReportsCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=ReportsViewModel}"
                                    Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="التقارير والإحصاءات" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateSettingsCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=SettingsViewModel}"
                                    Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="إعدادات النظام" />
                                </Button>
                                <Button Style="{StaticResource MenuItemButton}" Command="{Binding NavigateHelpCommand}"
                                        Tag="{Binding CurrentView, Converter={StaticResource ViewMatch}, ConverterParameter=HelpViewModel}">
                                    <TextBlock Text="الاختصارات والتعليمات" />
                                </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- زر فتح الشاشة الحالية في نافذة مستقلة (اتنقل من الصف القديم عشان الوظيفة ما تضيعش) -->
                    <Button Grid.Column="1" Command="{Binding OpenCurrentInSeparateWindowCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,6" Margin="6,0" VerticalAlignment="Center"
                            ToolTip="فتح هذه الشاشة في نافذة جديدة مستقلة لشاشات العرض المتعددة">
                        <TextBlock Text="⧉" FontSize="16" FontWeight="Bold" Foreground="#0284C7" />
                    </Button>
                </Grid>
            </Border>

            <!-- منطقة عرض الشاشة الحالية -->
            <!-- هامش سفلي 46 عشان شريط الاختصارات (Overlay) ما يغطيش المحتوى -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="6,6,6,46" />
        </Grid>

        <!-- شريط اختصارات لوحة المفاتيح (مكوّن مشترك مع النوافذ المستقلة): Overlay ملتصق بأسفل النافذة -->
        <views:ShortcutsBar Grid.Row="2" VerticalAlignment="Bottom" Panel.ZIndex="20" Target="{Binding CurrentView}" />
    </Grid>
</Window>
